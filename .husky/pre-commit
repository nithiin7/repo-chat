#!/usr/bin/env sh

if git diff --cached --name-only --diff-filter=ACM | grep -q '^frontend/'; then
  cd frontend && npx lint-staged && cd ..
fi

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '^backend/.*\.py$' || true)
if [ -n "$STAGED_PY" ]; then
  backend/.venv/bin/ruff check --fix $STAGED_PY
  backend/.venv/bin/ruff format $STAGED_PY
  git add $STAGED_PY
fi
